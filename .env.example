# LLM provider (OpenAI-compatible endpoint — vLLM, Ollama, or a proxy).
# Swap these to point at a different provider; no code change required.
LLM_BASE_URL=http://192.168.1.241:8000/v1
LLM_MODEL=nvidia/Qwen3.6-35B-A3B-NVFP4
# vLLM ignores the key but the OpenAI client requires a non-empty string.
LLM_API_KEY=not-needed

# Embeddings provider (separate vLLM process — /v1/embeddings, port 8001).
# OpenAI-compatible; swap to point at a different embedder, no code change.
EMBED_BASE_URL=http://192.168.1.241:8001/v1
EMBED_MODEL=Qwen/Qwen3-Embedding-4B
