# Copy to `.env` at the repo root: Django reads this file, with an optional
# `backend/.env` layered on top of it (backend keys win) and the real process
# environment winning over both. See `backend/config/env.py`.

# LLM_PROVIDER=vllm
LLM_PROVIDER=claude

# LLM provider (OpenAI-compatible endpoint — vLLM, Ollama, or a proxy).
# Swap these to point at a different provider; no code change required.
LLM_BASE_URL=http://192.168.1.241:8000/v1
LLM_MODEL=nvidia/Qwen3.6-35B-A3B-NVFP4
# vLLM ignores the key but the OpenAI client requires a non-empty string.
LLM_API_KEY=not-needed

# Anthropic (used when LLM_PROVIDER=claude, and always by the eval judge).
# No default for the key — it must come from the environment.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Eval judge model (`manage.py run_evals`). Kept separate from ANTHROPIC_MODEL
# so the generation model can be swapped without silently swapping the judge
# and invalidating every previously committed scorecard.
EVAL_JUDGE_MODEL=claude-opus-5

# Embeddings provider (separate vLLM process — /v1/embeddings, port 8001).
# OpenAI-compatible; swap to point at a different embedder, no code change.
EMBED_BASE_URL=http://192.168.1.241:8001/v1
EMBED_MODEL=Qwen/Qwen3-Embedding-4B

# Accepted lesson-plan generations per workspace per calendar month.
LESSON_PLAN_MONTHLY_GENERATION_LIMIT=30

# Demo mode — set to true for local demo environments only.
# With demo mode enabled, a guest lands on a persona picker that provisions
# a seeded demo workspace on demand. Requires DEBUG=true (local) OR a
# hardened DEMO_DEPLOY=true host (public).
# The app refuses to boot if DEMO_MODE is set while DEBUG is false and
# DEMO_DEPLOY is unset.
#
#   DEMO_MODE=true DEBUG=true python manage.py runserver
#
# DEMO_MODE=true   # Enable demo mode (requires DEBUG=true)
DEMO_MODE=true

# ---------------------------------------------------------------------------
# Demo hosting posture (Quizzy P6)
# ---------------------------------------------------------------------------
# Shared Redis cache for DRF throttle counters (broker stays on db 0).
# REDIS_CACHE_URL=redis://localhost:6379/1
#
# DemoSession TTL in hours; celery beat reaps expired tenants hourly.
# DEMO_SESSION_TTL_HOURS=24
#
# Public demo host — DEMO_MODE=true DEBUG=false DEMO_DEPLOY=true, plus:
#   - non-default DJANGO_SECRET_KEY
#   - explicit ALLOWED_HOSTS (not '*' / not localhost default)
#   - Redis CACHES["default"]
#   - SESSION_COOKIE_SECURE=true and CSRF_COOKIE_SECURE=true
#   - celery worker AND celery beat (TTL reap is inert without beat)
# Boot rejects DEMO_DEPLOY+DEBUG and any hardening gap above.
# DEMO_DEPLOY=false
